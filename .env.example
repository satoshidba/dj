# From https://developer.spotify.com/dashboard → your app → Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# The URL you open dj at. Spotify needs this exact value + /callback added as a
# Redirect URI in the dashboard. Must be https://… or http://127.0.0.1:<port>
# (Spotify no longer accepts http://localhost or plain-http LAN addresses).
APP_URL=http://127.0.0.1:8080

# Optional: for Briefs (AI playlists). https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: lock the app to specific Spotify user ids (comma separated).
# ALLOWED_SPOTIFY_IDS=

# Optional: how often to log new plays from Spotify (minutes, default 10).
# PLAY_POLL_MINUTES=10
